	partition Employees = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ibm_hr_attrition.csv"),[Delimiter=",", Columns=35, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Age", Int64.Type}, {"Attrition", type text}, {"BusinessTravel", type text}, {"DailyRate", Int64.Type}, {"Department", type text}, {"DistanceFromHome", Int64.Type}, {"Education", Int64.Type}, {"EducationField", type text}, {"EmployeeCount", Int64.Type}, {"EmployeeNumber", Int64.Type}, {"EnvironmentSatisfaction", Int64.Type}, {"Gender", type text}, {"HourlyRate", Int64.Type}, {"JobInvolvement", Int64.Type}, {"JobLevel", Int64.Type}, {"JobRole", type text}, {"JobSatisfaction", Int64.Type}, {"MaritalStatus", type text}, {"MonthlyIncome", Int64.Type}, {"MonthlyRate", Int64.Type}, {"NumCompaniesWorked", Int64.Type}, {"Over18", type text}, {"OverTime", type text}, {"PercentSalaryHike", Int64.Type}, {"PerformanceRating", Int64.Type}, {"RelationshipSatisfaction", Int64.Type}, {"StandardHours", Int64.Type}, {"StockOptionLevel", Int64.Type}, {"TotalWorkingYears", Int64.Type}, {"TrainingTimesLastYear", Int64.Type}, {"WorkLifeBalance", Int64.Type}, {"YearsAtCompany", Int64.Type}, {"YearsInCurrentRole", Int64.Type}, {"YearsSinceLastPromotion", Int64.Type}, {"YearsWithCurrManager", Int64.Type}}),
				    // constant columns, and pay rates that do not relate to MonthlyIncome
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type", {"EmployeeCount", "StandardHours", "Over18", "DailyRate", "HourlyRate", "MonthlyRate"}),
				    #"Added Left" = Table.AddColumn(#"Removed Columns", "Left", each if [Attrition] = "Yes" then 1 else 0, Int64.Type),
				    #"Added Status" = Table.AddColumn(#"Added Left", "Status", each if [Attrition] = "Yes" then "Left" else "Active", type text),
				    #"Added TenureBand" = Table.AddColumn(#"Added Status", "TenureBand", each
				        if [YearsAtCompany] <= 1 then "0-1 yrs"
				        else if [YearsAtCompany] <= 3 then "2-3 yrs"
				        else if [YearsAtCompany] <= 5 then "4-5 yrs"
				        else if [YearsAtCompany] <= 10 then "6-10 yrs"
				        else "10+ yrs", type text),
				    #"Added TenureOrder" = Table.AddColumn(#"Added TenureBand", "TenureOrder", each
				        if [YearsAtCompany] <= 1 then 1 else if [YearsAtCompany] <= 3 then 2
				        else if [YearsAtCompany] <= 5 then 3 else if [YearsAtCompany] <= 10 then 4 else 5, Int64.Type),
				    #"Added AgeBand" = Table.AddColumn(#"Added TenureOrder", "AgeBand", each
				        if [Age] <= 25 then "18-25" else if [Age] <= 35 then "26-35" else if [Age] <= 45 then "36-45" else "46-60", type text),
				    #"Added IncomeBand" = Table.AddColumn(#"Added AgeBand", "IncomeBand", each
				        if [MonthlyIncome] < 2500 then "Under 2.5k"
				        else if [MonthlyIncome] < 5000 then "2.5k-5k"
				        else if [MonthlyIncome] < 10000 then "5k-10k"
				        else "10k+", type text),
				    #"Added IncomeOrder" = Table.AddColumn(#"Added IncomeBand", "IncomeOrder", each
				        if [MonthlyIncome] < 2500 then 1 else if [MonthlyIncome] < 5000 then 2
				        else if [MonthlyIncome] < 10000 then 3 else 4, Int64.Type),
				    // one point per risk factor, same rules as sql/05_flight_risk.sql
				    #"Added RiskScore" = Table.AddColumn(#"Added IncomeOrder", "RiskScore", each
				        (if [OverTime] = "Yes" then 1 else 0)
				        + (if [JobLevel] = 1 then 1 else 0)
				        + (if [YearsAtCompany] <= 2 then 1 else 0)
				        + (if [MaritalStatus] = "Single" then 1 else 0)
				        + (if [StockOptionLevel] = 0 then 1 else 0)
				        + (if [BusinessTravel] = "Travel_Frequently" then 1 else 0)
				        + (if [JobSatisfaction] = 1 or [EnvironmentSatisfaction] = 1 then 1 else 0), Int64.Type),
				    #"Added RiskGroup" = Table.AddColumn(#"Added RiskScore", "RiskGroup", each
				        if [RiskScore] >= 4 then "High" else "Low / medium", type text)
				in
				    #"Added RiskGroup"

	annotation PBI_ResultType = Table

