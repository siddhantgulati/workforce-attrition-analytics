table Employees
	lineageTag: 64c9b982-1afd-42e7-8b21-0cdb6148ddaa

	measure Headcount = COUNTROWS ( Employees )
		formatString: #,0
		lineageTag: 7f78c7d9-2b3b-4a79-80f4-ded0cdede1ee

	measure Leavers = SUM ( Employees[Left] )
		formatString: #,0
		lineageTag: 1baa46b1-d78f-40fd-b4da-2bd3a2c45865

	measure Active = [Headcount] - [Leavers]
		formatString: #,0
		lineageTag: 542ffac8-68a1-4c01-ab47-2694dc51c3ae

	measure 'Attrition %' = DIVIDE ( [Leavers], [Headcount] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3ea1b343-eb45-4c3c-a8f2-e0eabfc57037

	measure 'Company Attrition %' = CALCULATE ( [Attrition %], ALL ( Employees ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9d6e2cfa-24f0-4de7-b470-fb6b407f80de

	measure 'vs Company (pts)' = ( [Attrition %] - [Company Attrition %] ) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: 9974f330-a2b9-48e8-a725-89a6bb96a0f8

	measure 'Attrition % Overtime' = CALCULATE ( [Attrition %], Employees[OverTime] = "Yes" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 861b3fbf-d0b2-4621-91ee-e49daf92befd

	measure 'Attrition % No Overtime' = CALCULATE ( [Attrition %], Employees[OverTime] = "No" )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 43620c2a-ccc1-4cc3-bc62-bb317f3d10ac

	measure 'High Risk Active' = CALCULATE ( [Active], Employees[RiskScore] >= 4 )
		formatString: #,0
		lineageTag: 7391f6cf-a714-42e5-9ac1-69fce91c66c7

	measure 'Avg Monthly Income' = AVERAGE ( Employees[MonthlyIncome] )
		formatString: #,0
		lineageTag: f37fd248-b89a-4100-a162-db3daf9782f9

	measure 'Share of Leavers' = DIVIDE ( [Leavers], CALCULATE ( [Leavers], ALL ( Employees ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 94f87149-132d-46cf-9afb-83f70b6d1f98

	measure 'Headcount Label' = FORMAT ( [Headcount], "#,0" )
		lineageTag: 6b8a6895-3ecf-4df2-acf4-a68cf002ceb6

